{
  "$schema": "https://app.kilo.ai/config.json",
  "agent": {
    "api-gateway": {
      "description": "Specialized for API gateway configuration, routing, and Kong/OpenResty setup",
      "mode": "primary",
      "color": "#3B82F6",
      "model": "opus",
      "reasoning_effort": "medium",
      "permission": {
        "edit": {
          "services/api-gateway/**": "allow",
          "**": "deny"
        },
        "bash": "deny"
      }
    },
    "account-service": {
      "description": "Specialized for account service development and operations",
      "mode": "primary",
      "color": "#10B981",
      "model": "opus",
