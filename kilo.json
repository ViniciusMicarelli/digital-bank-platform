      "permission": {
        "edit": {
          "infrastructure/**": "allow",
          "**": "deny"
        },
        "bash": "deny"
      }
    },
    "contract-dev": {
      "description": "Specialized for API contract development, OpenAPI, and Protobuf",
      "mode": "primary",
      "color": "#E879F9",
      "model": "opus",
      "reasoning_effort": "medium",
      "permission": {
        "edit": {
          "contracts/**": "allow",
          "**": "deny"
        },
        "bash": "deny"
      }
    },
    "dev-environment": {
      "description": "Specialized for Docker Compose development environment setup and troubleshooting",
      "mode": "primary",
      "color": "#84CC16",
      "model": "opus",
      "reasoning_effort": "medium",
      "permission": {
        "edit": {
          "docker-compose.dev.yml": "allow",
          "docker-compose.prod.yml": "allow",
          "**/Dockerfile": "allow",
          "**.dockerignore": "allow",
          "**": "deny"
        },
        "bash": {
          "docker-compose.dev.yml": "allow",
          "docker-compose.prod.yml": "allow",
          "scripts/*.sh": "allow",
          "**/tests/**": "allow",
          "**": "deny"
        }
      }
    },
    "dev-full": {
      "description": "Full development environment with all services - read/write access to everything",
      "mode": "primary",
      "color": "#A78BFA",
      "model": "opus",
      "reasoning_effort": "low",
      "permission": {
        "edit": {
          "*": "allow"
        },
        "bash": {
          "*": "allow"
        }
      }
